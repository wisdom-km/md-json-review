{
  "type_patterns": [
    {"pattern": "^[一二三四五六七八九十]+[.．、]\\s*(单选题)\\s*$", "type": "single_choice"},
    {"pattern": "^[一二三四五六七八九十]+[.．、]\\s*(多选题)\\s*$", "type": "multiple_choice"},
    {"pattern": "^[一二三四五六七八九十]+[.．、]\\s*(选择题)\\s*$", "type": "choice"},
    {"pattern": "^[一二三四五六七八九十]+[.．、]\\s*(填空题)\\s*$", "type": "fill_blank"},
    {"pattern": "^[一二三四五六七八九十]+[.．、]\\s*(解答题)\\s*$", "type": "solution"}
  ],
  "option_pattern": "([A-D])[.．、]\\s*",
  "option_keys": ["A", "B", "C", "D"],
  "option_required_types": ["single_choice", "multiple_choice", "choice"],
  "subquestion_markers": ["[（(](\\d+)[）)]"],
  "reject_on_missing_options": false,
  "needs_confirm_threshold": 2
}
